rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Token lookup by pairing code; no listing allowed.
    match /devices/{code} {
      allow get: if false;
      allow create, update: if request.auth != null;
    }
    match /commands/{id} {
      allow create: if request.auth != null
                    && request.resource.data.action == 'SCREEN_ON'
                    && request.resource.data.deviceCode is string;
    }
  }
}
